# Cloud service
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8000
VEHICLE_INGEST_TOKEN=replace-with-a-long-random-secret
OFFLINE_AFTER_SECONDS=4
MAX_FRAME_BYTES=4194304
CLOUD_FRAME_BUFFER_FRAMES=300
FMP4_BUFFER_SEGMENTS=300
BLUETOOTH_OFFLINE_AFTER_SECONDS=10
MAX_BLUETOOTH_TEXT_BYTES=2048
WIFI_OFFLINE_AFTER_SECONDS=10
MAX_WIFI_TEXT_BYTES=4096
NAVIGATION_OFFLINE_AFTER_SECONDS=10
# 高德地图 JS API 2.0。生产环境优先配置 AMAP_SERVICE_HOST 代理安全密钥。
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_SERVICE_HOST=
LOG_LEVEL=INFO

# Vehicle agent
VEHICLE_ID=VHC-001
CLOUD_HTTP_URL=http://127.0.0.1:8000
BLE_UDP_HOST=0.0.0.0
BLE_UDP_PORT=5000
WIFI_UDP_HOST=0.0.0.0
WIFI_UDP_PORT=6000
RTSP_URL=rtsp://192.168.4.88:8554/main
CLOUD_WS_URL=ws://127.0.0.1:8000
VIDEO_MAX_WIDTH=1280
VIDEO_TARGET_FPS=30
VIDEO_BITRATE_KBPS=2800
VIDEO_SEGMENT_MS=1000
VIDEO_BUFFER_SECONDS=300
VIDEO_SEND_TIMEOUT=60
# Legacy JPEG fallback settings:
JPEG_QUALITY=88
JPEG_MIN_QUALITY=52
TARGET_KBPS=12000
WS_WRITE_LIMIT_BYTES=1048576
MAX_FRAME_AGE_SECONDS=18
WS_SEND_TIMEOUT=5
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
VEHICLE_NAVIGATION_FILE=

# Recommended overrides for a Jetson vehicle using a mobile hotspot:
# VIDEO_MAX_WIDTH=640
# VIDEO_FPS=10
# JPEG_QUALITY=55
# TARGET_KBPS=1800
