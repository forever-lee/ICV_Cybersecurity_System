# Cloud service only. Jetson settings are documented in jetson_edge/README.md.
VEHICLE_INGEST_TOKEN=replace-with-a-long-random-secret
DASHBOARD_ACCESS_TOKEN=replace-with-a-separate-view-secret
PUBLIC_DASHBOARD_URL=http://your-cpolar-host
OFFLINE_AFTER_SECONDS=20
FMP4_BUFFER_SEGMENTS=4
NAVIGATION_OFFLINE_AFTER_SECONDS=10
BLUETOOTH_OFFLINE_AFTER_SECONDS=10
BLUETOOTH_CONTROL_OFFLINE_AFTER_SECONDS=5
WIFI_OFFLINE_AFTER_SECONDS=10
BODY_CONTROL_TIMEOUT_MS=10000
MAX_BLUETOOTH_TEXT_BYTES=2048
MAX_WIFI_TEXT_BYTES=4096
MAX_COMPARISON_IMAGE_BYTES=4194304
# Optional absolute or project-relative path to the HMI comparison algorithm.
HMI_COMPARISON_PATH=
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_SERVICE_HOST=
LOG_LEVEL=INFO
